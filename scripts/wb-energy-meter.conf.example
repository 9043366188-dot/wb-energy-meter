# wb-energy-meter — пример конфига

mqtt:
  host: 127.0.0.1
  port: 1883

http:
  host: 0.0.0.0
  port: 8080

device_prefix: "wb-map3e_"

status:
  # Нет ЛЮБЫХ сообщений дольше N секунд -> "нет связи".
  # Для WB-MAP3E fw2 (event-driven) рекомендуется 600-1800 с.
  # При включённом канале Uptime (раз в 2с) достаточно 60 с.
  no_connection_timeout_s: 600
  stale_warning_timeout_s: 120
  undervoltage_v: 198.0
  overvoltage_v: 253.0
  phase_lost_v: 150.0
  freq_min_hz: 49.0
  freq_max_hz: 51.0

aggregator:
  enabled: true
  catchup_days: 90
  max_catchup_duration_s: 300
  recompute_recent_h: 168
  hour_offset_s: 90
  catchup_start_delay_s: 10
  patcher_interval_h: 6
  rpc_timeout_s: 15.0
  rpc_max_retries: 3

log_file: /var/log/wb-energy-meter/wb-energy-meter.log

meters:
  - device_id: wb-map3e_16
    display_name: "Тестовый счётчик 1"
    group: "Тестовая зона"
