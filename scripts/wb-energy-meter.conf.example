# wb-energy-meter — пример конфига

mqtt:
  host: 127.0.0.1
  port: 1883

http:
  host: 0.0.0.0
  port: 8080

device_prefix: "wb-map3e_"

status:
  # Нет ЛЮБЫХ сообщений дольше N секунд -> "нет связи".
  # Для WB-MAP3E fw2 (event-driven) рекомендуется 600-1800 с.
  # При включённом канале Uptime (раз в 2с) достаточно 60 с.
  no_connection_timeout_s: 600
  stale_warning_timeout_s: 120
  undervoltage_v: 198.0
  overvoltage_v: 253.0
  phase_lost_v: 150.0
  freq_min_hz: 49.0
  freq_max_hz: 51.0

aggregator:
  enabled: true
  catchup_days: 90
  max_catchup_duration_s: 300
  recompute_recent_h: 168
  hour_offset_s: 90
  catchup_start_delay_s: 10
  patcher_interval_h: 6
  rpc_timeout_s: 15.0
  rpc_max_retries: 3

# Самообновление из GitHub по кнопке в веб-интерфейсе (v0.9.0+).
# Источник — ветка main, не теги: что в main, то и установится.
# ВНИМАНИЕ: у сервиса нет аутентификации (см. README, раздел
# "Обновление"). Если http.host: 0.0.0.0 и контроллер в недоверенной
# сети — ЛЮБОЙ в этой сети может нажать кнопку и перезапустить сервис.
# Поставьте allow_from_ui: false либо http.host: 127.0.0.1 (доступ
# только через SSH-туннель), если это неприемлемо.
update:
  enabled: true
  allow_from_ui: true
  repo_owner: 9043366188-dot
  repo_name: wb-energy-meter
  ref: main
  check_timeout_s: 10

# Канал Uptime и конфиг драйвера wb-mqtt-serial (v0.10.0).
# Диагностика состояния канала работает ВСЕГДА и только на чтение —
# секция нужна лишь чтобы переопределить пути или разрешить правку.
#
# ВНИМАНИЕ: /etc/wb-mqtt-serial.conf — чужой файл, в нём описаны ВСЕ
# устройства контроллера (реле, датчики, приводы). allow_edit: true даёт
# сервису право записи в него, а кнопка «Перезапустить опрос» на
# несколько секунд прерывает опрос всех устройств объекта. Поэтому по
# умолчанию правка ВЫКЛЮЧЕНА, а канал включается вручную:
# Device Manager -> устройство -> HW Info -> Uptime -> in queue order.
wb_serial:
  config_path: /etc/wb-mqtt-serial.conf
  templates_dirs:
    - /usr/share/wb-mqtt-serial/templates
    - /etc/wb-mqtt-serial.conf.d/templates
  allow_edit: false
  backup_dir: /mnt/data/var/lib/wb-energy-meter/wb-serial-backups
  service_name: wb-mqtt-serial

log_file: /var/log/wb-energy-meter/wb-energy-meter.log

meters:
  - device_id: wb-map3e_16
    display_name: "Тестовый счётчик 1"
    group: "Тестовая зона"
